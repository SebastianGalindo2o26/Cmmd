[Unit]
Description=POS Restaurante (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/pos-restaurante
ExecStart=/usr/bin/docker compose --env-file .env -f infra/docker-compose.yml up -d
ExecStop=/usr/bin/docker compose --env-file .env -f infra/docker-compose.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
